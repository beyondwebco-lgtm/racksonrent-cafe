<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800" fill="none">
  <rect width="1200" height="800" fill="#FFFDF5"/>
  <rect x="30" y="30" width="1140" height="740" rx="32" fill="#FFFFFF" stroke="#F0E2E4" stroke-width="4"/>
  <rect x="60" y="60" width="1080" height="90" rx="20" fill="#650000"/>
  <text x="600" y="115" font-family="sans-serif" font-size="32" font-weight="900" fill="#FFFBCC" text-anchor="middle">SPACE OWNER JOURNEY — STEP-BY-STEP INFOGRAPHIC</text>
  
  <!-- Step 1 -->
  <rect x="80" y="190" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="130" cy="240" r="30" fill="#650000"/>
  <text x="130" y="250" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">1</text>
  <text x="180" y="245" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">Identify Space</text>
  <text x="100" y="295" font-family="sans-serif" font-size="15" fill="#5F5F5F">Locate unused shelves,</text>
  <text x="100" y="320" font-family="sans-serif" font-size="15" fill="#5F5F5F">counters &amp; display racks.</text>

  <!-- Step 2 -->
  <rect x="440" y="190" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="490" cy="240" r="30" fill="#650000"/>
  <text x="490" y="250" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">2</text>
  <text x="540" y="245" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">List Your Space</text>
  <text x="460" y="295" font-family="sans-serif" font-size="15" fill="#5F5F5F">Submit details &amp; photos</text>
  <text x="460" y="320" font-family="sans-serif" font-size="15" fill="#5F5F5F">on Racks on Rent.</text>

  <!-- Step 3 -->
  <rect x="800" y="190" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="850" cy="240" r="30" fill="#650000"/>
  <text x="850" y="250" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">3</text>
  <text x="900" y="245" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">Match Brands</text>
  <text x="820" y="295" font-family="sans-serif" font-size="15" fill="#5F5F5F">Connect with premium</text>
  <text x="820" y="320" font-family="sans-serif" font-size="15" fill="#5F5F5F">partner brands.</text>

  <!-- Step 4 -->
  <rect x="80" y="460" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="130" cy="510" r="30" fill="#650000"/>
  <text x="130" y="520" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">4</text>
  <text x="180" y="515" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">Agree Terms</text>
  <text x="100" y="565" font-family="sans-serif" font-size="15" fill="#5F5F5F">Flexible daily, weekly,</text>
  <text x="100" y="590" font-family="sans-serif" font-size="15" fill="#5F5F5F">or monthly rental agreement.</text>

  <!-- Step 5 -->
  <rect x="440" y="460" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="490" cy="510" r="30" fill="#650000"/>
  <text x="490" y="520" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">5</text>
  <text x="540" y="515" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">Install Racks</text>
  <text x="460" y="565" font-family="sans-serif" font-size="15" fill="#5F5F5F">Attractive displays set up</text>
  <text x="460" y="590" font-family="sans-serif" font-size="15" fill="#5F5F5F">with zero disturbance.</text>

  <!-- Step 6 -->
  <rect x="800" y="460" width="320" height="230" rx="20" fill="#FFFDF5" stroke="#F0E2E4" stroke-width="2"/>
  <circle cx="850" cy="510" r="30" fill="#650000"/>
  <text x="850" y="520" font-family="sans-serif" font-size="24" font-weight="900" fill="#FAFA33" text-anchor="middle">6</text>
  <text x="900" y="515" font-family="sans-serif" font-size="20" font-weight="800" fill="#650000">Earn Income</text>
  <text x="820" y="565" font-family="sans-serif" font-size="15" fill="#5F5F5F">Collect monthly payout</text>
  <text x="820" y="590" font-family="sans-serif" font-size="15" fill="#5F5F5F">from sublet space.</text>
</svg>
